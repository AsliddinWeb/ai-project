# Savollar
msgid "Qalqonsimon bez saratoni nima?"
msgstr "Что такое рак щитовидной железы?"

msgid "Qalqonsimon bez saratoni sabablari nima bo'lishi mumkin?"
msgstr "Каковы причины рака щитовидной железы?"

msgid "Qalqonsimon bez saratonining turlari qanday?"
msgstr "Какие бывают типы рака щитовидной железы?"

msgid "Kasallikning dastlabki belgilari qanday bo'ladi?"
msgstr "Каковы первые признаки заболевания?"

msgid "Qanday qilib aniqlanadi (diagnostika)?"
msgstr "Как диагностируется заболевание?"

msgid "Davolash qanday amalga oshiriladi?"
msgstr "Как проводится лечение?"

msgid "Qalqonsimon bez saratoni yuqumlimi?"
msgstr "Заразен ли рак щитовидной железы?"

msgid "Odam to'liq sog'ayib ketishi mumkinmi?"
msgstr "Можно ли полностью выздороветь?"

# Javoblar - FAQ 1
msgid "Qalqonsimon bez saratoni — bu bo'yinning old qismida joylashgan qalqonsimon bez hujayralarining nazoratsiz o'sishi natijasida paydo bo'ladigan o'sma kasalligidir."
msgstr "Рак щитовидной железы — это опухолевое заболевание, возникающее в результате неконтролируемого роста клеток щитовидной железы, расположенной в передней части шеи."

msgid "Muhim:"
msgstr "Важно:"

msgid "Qalqonsimon bez metabolizm va gormonlar ishlab chiqarishda muhim rol o'ynaydi. Bu bezning saratoni erta bosqichda aniqlanganida davolash samaradorligi yuqori."
msgstr "Щитовидная железа играет важную роль в метаболизме и выработке гормонов. Эффективность лечения рака этой железы высока при раннем обнаружении."

# FAQ 2
msgid "Asosiy xavf omillari:"
msgstr "Основные факторы риска:"

msgid "Irsi omillar (oila a'zolarida bo'lgan holatlar)"
msgstr "Наследственные факторы (случаи в семье)"

msgid "Radiatsiyaga ta'sirlanish (bolalikda nurlanish olgan bo'lish)"
msgstr "Воздействие радиации (облучение в детстве)"

msgid "Gormon disbalansi yoki yod yetishmasligi"
msgstr "Гормональный дисбаланс или дефицит йода"

msgid "Ba'zi genetik sindromlar (masalan, MEN 2 sindromi)"
msgstr "Некоторые генетические синдромы (например, синдром МЭН 2)"

msgid "Ogohlantirish:"
msgstr "Предупреждение:"

msgid "Agar oilangizda qalqonsimon bez kasalliklari bo'lgan bo'lsa, muntazam tekshiruvdan o'tishni tavsiya etamiz."
msgstr "Если в вашей семье были заболевания щитовидной железы, рекомендуем регулярно проходить обследование."

# FAQ 3
msgid "Eng ko'p uchraydigan turlari:"
msgstr "Наиболее распространенные типы:"

msgid "Papillyar"
msgstr "Папиллярный"

msgid "eng keng tarqalgan, sekin o'sadi"
msgstr "самый распространенный, медленно растет"

msgid "Follikulyar"
msgstr "Фолликулярный"

msgid "ikkinchi darajada keng tarqalgan"
msgstr "второй по распространенности"

msgid "Medullyar"
msgstr "Медуллярный"

msgid "kamroq uchraydi"
msgstr "встречается реже"

msgid "Anaplastik"
msgstr "Анапластический"

msgid "kam uchraydi, lekin agressiv kechadi"
msgstr "встречается редко, но протекает агрессивно"

msgid "Yaxshi xabar:"
msgstr "Хорошая новость:"

msgid "Papillyar va follikulyar turlarining davolash natijalari juda yaxshi, agar erta aniqlansa prognoz ijobiy."
msgstr "Результаты лечения папиллярного и фолликулярного типов очень хорошие, прогноз положительный при раннем обнаружении."

# FAQ 4
msgid "Asosiy simptomlar:"
msgstr "Основные симптомы:"

msgid "Bo'yinda tugun yoki shish paydo bo'lishi"
msgstr "Появление узла или припухлости на шее"

msgid "Yutishda yoki nafas olishda qiyinchilik"
msgstr "Затруднение при глотании или дыхании"

msgid "Ovozda o'zgarish (xirillash)"
msgstr "Изменение голоса (хрипота)"

msgid "Bo'yin og'rigi yoki noqulaylik"
msgstr "Боль или дискомфорт в шее"

msgid "Ba'zida hech qanday simptom bo'lmasligi ham mumkin"
msgstr "Иногда может не быть никаких симптомов"

msgid "Agar bu belgilardan birortasini sezsangiz, darhol shifokorga murojaat qiling!"
msgstr "Если вы заметили какие-либо из этих признаков, немедленно обратитесь к врачу!"

# FAQ 5
msgid "Diagnostika usullari:"
msgstr "Методы диагностики:"

msgid "Qalqonsimon bez UZI"
msgstr "УЗИ щитовидной железы"

msgid "Qon tahlillari (TSH, T3, T4, kalsitonin va h.k.)"
msgstr "Анализы крови (ТТГ, Т3, Т4, кальцитонин и т.д.)"

msgid "Biopsiya (o'sma hujayralarini mikroskopda tekshirish)"
msgstr "Биопсия (исследование клеток опухоли под микроскопом)"

msgid "KT yoki MRT (kengaygan holatlarni aniqlash uchun)"
msgstr "КТ или МРТ (для выявления распространенных случаев)"

msgid "Bizning sun'iy intellekt tizimimiz ultratovush rasmlari va laboratoriya ma'lumotlarini tahlil qilib, dastlabki tashxis berishda yordam beradi!"
msgstr "Наша система искусственного интеллекта анализирует УЗИ-изображения и лабораторные данные, помогая в постановке первичного диагноза!"

# FAQ 6
msgid "Davolash usullari:"
msgstr "Методы лечения:"

msgid "Jarrohlik"
msgstr "Хирургия"

msgid "bezni qisman yoki to'liq olib tashlash"
msgstr "частичное или полное удаление железы"

msgid "Radioaktiv yod bilan davolash"
msgstr "Лечение радиоактивным йодом"

msgid "qoldiq saraton hujayralarini yo'q qilish"
msgstr "уничтожение остаточных раковых клеток"

msgid "Gormon terapiyasi"
msgstr "Гормональная терапия"

msgid "TSH darajasini boshqarish uchun"
msgstr "для контроля уровня ТТГ"

msgid "Kimyo- yoki nurlanish terapiyasi"
msgstr "Химио- или лучевая терапия"

msgid "ba'zi hollarda"
msgstr "в некоторых случаях"

msgid "Davolash rejasi individual bo'lib, kasallikning turi va bosqichiga qarab belgilanadi."
msgstr "План лечения индивидуален и определяется типом и стадией заболевания."

# FAQ 7
msgid "Yo'q!"
msgstr "Нет!"

msgid "Qalqonsimon bez saratoni yuqumli emas — ya'ni boshqalarga o'tmaydi."
msgstr "Рак щитовидной железы не заразен — то есть не передается другим."

msgid "Saraton kasalliklari odamdan odamga yuqmaydi. Bu hujayralarning genetik o'zgarishlari natijasida yuzaga keladigan kasallikdir."
msgstr "Раковые заболевания не передаются от человека к человеку. Это заболевание, возникающее в результате генетических изменений клеток."

# FAQ 8
msgid "Ha!"
msgstr "Да!"

msgid "Ko'pchilik bemorlar to'liq sog'ayib ketadi, ayniqsa papillyar va follikulyar turlarida. Erta bosqichda aniqlansa, prognoz juda yaxshi."
msgstr "Большинство пациентов полностью выздоравливают, особенно при папиллярном и фолликулярном типах. При раннем обнаружении прогноз очень хороший."

msgid "Statistika:"
msgstr "Статистика:"

msgid "Papillyar saraton: 98% dan ortiq 5 yillik omon qolish"
msgstr "Папиллярный рак: более 98% 5-летней выживаемости"

msgid "Follikulyar saraton: 95% dan ortiq 5 yillik omon qolish"
msgstr "Фолликулярный рак: более 95% 5-летней выживаемости"

msgid "Erta aniqlangan holatda: deyarli 100% davolanadi"
msgstr "При раннем обнаружении: излечивается почти в 100% случаев"

msgid "Maslahat:"
msgstr "Совет:"

msgid "Muntazam tekshiruvdan o'ting va shifokor tavsiyalariga rioya qiling!"
msgstr "Регулярно проходите обследование и следуйте рекомендациям врача!"

# CTA Section
msgid "TAMES AI Tizimi Bilan Tashxis"
msgstr "Диагностика с системой TAMES AI"

msgid "Sun'iy intellekt yordamida qalqonsimon bez xavfli o'smalarini professional baholash. Dastlabki tashxisni bir necha daqiqada oling!"
msgstr "Профессиональная оценка злокачественных новообразований щитовидной железы с помощью искусственного интеллекта. Получите первичный диагноз за несколько минут!"

msgid "Tizim Haqida"
msgstr "О системе"

